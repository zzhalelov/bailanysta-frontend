# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

cat << 'EOF' > .gitignore
# Logs

# Dependency directory
node_modules/

# Build output
dist/
dist-ssr/

# TypeScript cache
tsconfig.tsbuildinfo

# IDE files
.idea/
*.iml
.vscode/

# OS specific
Thumbs.db
EOF